# Server
PORT=8080
ENV=development
API_PREFIX=/api/v1

# "All-On" mode for production: enables all feature-flagged modules at once
ENABLE_ALL_FEATURES=false

ROUTE_TO_GO=false
SHADOW_TRAFFIC=false
LEGACY_READONLY=false
CANARY_PERCENTAGE=0
CUTOVER_STAGE_HEADER=X-Cutover-Stage
CUTOVER_SEGMENT_HEADER=X-Client-Segment
LEGACY_HEALTH_URL=http://localhost:3000/health
GO_HEALTH_URL=http://localhost:8080/health
CUTOVER_HEALTH_TIMEOUT=2s
ENABLE_HOMEROOMS=true
ENABLE_CALENDAR_ALIAS=true
ENABLE_ATTENDANCE_ALIAS=true
ENABLE_CONFIGURATION_API=true
CONFIG_ACTIVE_TERM_ID=
CONFIG_DEFAULT_DASHBOARD_TERM_ID=
CONFIG_DEFAULT_CALENDAR_TERM_ID=

# Database
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=admin_panel_sma
DB_SSL_MODE=disable
DB_MAX_OPEN_CONNS=25
DB_MAX_IDLE_CONNS=5

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0
REDIS_TLS=false

# JWT (reserved)
JWT_SECRET=change_me_in_prod
JWT_EXPIRATION=24h
REFRESH_TOKEN_EXPIRATION=168h

# Admin password reset
PASSWORD_RESET_TOKEN_TTL=1h
PASSWORD_RESET_URL=http://localhost:5173/admin/reset-password
# Production must override this with a real HTTPS portal hostname.
PORTAL_PASSWORD_RESET_URL=http://localhost:5173/portal/reset-password
PASSWORD_RESET_EMAIL_SUBJECT=Atur ulang kata sandi Admin SMA

# SMTP password-reset delivery (production only; development logs a redacted event)
SMTP_ENABLED=false
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
# starttls (recommended), tls (implicit TLS), or none (local test SMTP only)
SMTP_TLS_MODE=starttls
SMTP_TIMEOUT=10s

# CORS
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# In-process defense-in-depth limiter (the edge proxy owns production limits)
RATE_LIMIT_REQUESTS_PER_MINUTE=120
RATE_LIMIT_BURST=60
RATE_LIMIT_MAX_CLIENTS=10000

# Logging
LOG_LEVEL=debug
LOG_FORMAT=json

# Analytics
ENABLE_ANALYTICS=true
ANALYTICS_CACHE_TTL=10m

# Dashboard
ENABLE_DASHBOARD=true
DASHBOARD_CACHE_TTL=5m

# Scheduler
ENABLE_SCHEDULER=true
SCHEDULER_PROPOSAL_TTL=30m

# Reports
ENABLE_REPORTS=true
REPORTS_STORAGE_DIR=./exports
REPORTS_SIGNED_URL_SECRET=change_me_reports
REPORTS_SIGNED_URL_TTL=24h
REPORTS_CLEANUP_INTERVAL=30m
REPORTS_WORKER_CONCURRENCY=2
REPORTS_WORKER_RETRIES=3

# Mutations
ENABLE_MUTATIONS=true

# Archives
ENABLE_ARCHIVES=true
ARCHIVES_STORAGE_DIR=./archives
ARCHIVES_SIGNED_URL_SECRET=change_me_archives
ARCHIVES_SIGNED_URL_TTL=30m
ARCHIVES_MAX_FILE_SIZE=10485760
ARCHIVES_ALLOWED_MIME_TYPES=application/pdf,application/vnd.openxmlformats-officedocument.wordprocessingml.document,application/vnd.openxmlformats-officedocument.spreadsheetml.sheet,application/zip

# Homerooms
ENABLE_HOMEROOMS=true

# Calendar & Attendance alias
ENABLE_CALENDAR_ALIAS=true
ENABLE_ATTENDANCE_ALIAS=true
