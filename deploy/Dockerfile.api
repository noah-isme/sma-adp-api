# syntax=docker/dockerfile:1.7
#
# The production compose file supplies an immutable image@sha256 reference for
# the resulting image. Builder image updates are reviewed together with the
# release lock file; do not use a floating latest tag for a production release.

ARG GO_VERSION=1.21
FROM golang:${GO_VERSION}-bookworm AS builder

WORKDIR /src
COPY go.mod go.sum ./
RUN go mod download

COPY . .
RUN CGO_ENABLED=0 GOOS=linux GOARCH=amd64 \
    go build -trimpath -ldflags="-s -w" \
    -o /out/api-gateway ./cmd/api-gateway
RUN CGO_ENABLED=0 GOOS=linux GOARCH=amd64 \
    go build -trimpath -ldflags="-s -w" \
    -o /out/healthcheck ./deploy/healthcheck

# Distroless nonroot has no shell or package manager. The healthcheck helper is
# compiled into the image so health probes do not require curl/wget in runtime.
FROM gcr.io/distroless/static-debian12:nonroot

ARG VERSION=dev
LABEL org.opencontainers.image.title="SMA ADP API" \
      org.opencontainers.image.version="${VERSION}" \
      org.opencontainers.image.source="https://github.com/noah-isme/sma"

WORKDIR /app
COPY --from=builder /out/api-gateway /usr/local/bin/api-gateway
COPY --from=builder /out/healthcheck /usr/local/bin/healthcheck
USER nonroot:nonroot
EXPOSE 8080
ENTRYPOINT ["/usr/local/bin/api-gateway"]
HEALTHCHECK --interval=10s --timeout=3s --start-period=20s --retries=5 CMD ["/usr/local/bin/healthcheck"]
