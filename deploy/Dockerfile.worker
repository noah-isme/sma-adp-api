# syntax=docker/dockerfile:1.7
#
# The API currently owns the in-process report queue. This image is kept as a
# separately pinned deployment input so a dedicated worker entrypoint can be
# introduced without changing the release topology. Until that entrypoint
# exists, enable the compose worker profile only for a controlled drill; it
# runs the same binary on an isolated port and is never exposed by Nginx.

ARG GO_VERSION=1.21
FROM golang:${GO_VERSION}-bookworm AS builder

WORKDIR /src
COPY go.mod go.sum ./
RUN go mod download

COPY . .
RUN CGO_ENABLED=0 GOOS=linux GOARCH=amd64 \
    go build -trimpath -ldflags="-s -w" \
    -o /out/api-gateway ./cmd/api-gateway
RUN CGO_ENABLED=0 GOOS=linux GOARCH=amd64 \
    go build -trimpath -ldflags="-s -w" \
    -o /out/healthcheck ./deploy/healthcheck

FROM gcr.io/distroless/static-debian12:nonroot

ARG VERSION=dev
LABEL org.opencontainers.image.title="SMA ADP worker runtime" \
      org.opencontainers.image.version="${VERSION}" \
      org.opencontainers.image.source="https://github.com/noah-isme/sma"

WORKDIR /app
COPY --from=builder /out/api-gateway /usr/local/bin/api-gateway
COPY --from=builder /out/healthcheck /usr/local/bin/healthcheck
USER nonroot:nonroot
EXPOSE 8081
ENTRYPOINT ["/usr/local/bin/api-gateway"]
HEALTHCHECK --interval=10s --timeout=3s --start-period=20s --retries=5 CMD ["/usr/local/bin/healthcheck"]
