# Copy to /etc/sma/sma-api.env and keep the real file outside the repository.
# Every release image must be an immutable digest, never a floating tag.
SMA_API_IMAGE=ghcr.io/example/sma-api:release@sha256:REPLACE_WITH_64_HEX_DIGEST
SMA_WORKER_IMAGE=ghcr.io/example/sma-worker:release@sha256:REPLACE_WITH_64_HEX_DIGEST
NGINX_IMAGE=nginx:1.27-alpine@sha256:REPLACE_WITH_64_HEX_DIGEST
PROMETHEUS_IMAGE=prom/prometheus:v2.53.0@sha256:REPLACE_WITH_64_HEX_DIGEST
ALERTMANAGER_IMAGE=prom/alertmanager:v0.27.0@sha256:REPLACE_WITH_64_HEX_DIGEST
GRAFANA_IMAGE=grafana/grafana:11.1.0@sha256:REPLACE_WITH_64_HEX_DIGEST

SMA_ENV_FILE=/etc/sma/sma-api.env
TLS_DIR=/etc/sma/tls
SERVER_NAME=api.example.com
LEGACY_UPSTREAM=legacy.internal.example.com:3000
ROUTE_TO_GO=false
SHADOW_TRAFFIC=false
LEGACY_READONLY=false
CANARY_PERCENTAGE=0
GRAFANA_ROOT_URL=https://grafana.example.com
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=REPLACE_IN_SECRET_STORE

# These values are read by the Go API from the same file. Use managed services,
# private networking, least-privilege credentials, and TLS in production.
ENV=production
PORT=8080
ALLOWED_ORIGINS=https://admin.example.com
DB_HOST=managed-postgres.example.com
DB_PORT=5432
DB_USER=sma_api
DB_PASSWORD=REPLACE_IN_SECRET_STORE
DB_NAME=admin_panel_sma
DB_SSL_MODE=require
DB_MAX_OPEN_CONNS=50
DB_MAX_IDLE_CONNS=10
JWT_SECRET=REPLACE_IN_SECRET_STORE
REFRESH_TOKEN_EXPIRATION=168h
REDIS_HOST=managed-redis.example.com
REDIS_PORT=6379
REDIS_PASSWORD=REPLACE_IN_SECRET_STORE
REDIS_DB=0
REDIS_TLS=true

# Password-reset delivery is a production startup requirement.
PASSWORD_RESET_TOKEN_TTL=1h
PASSWORD_RESET_URL=https://admin.example.com/admin/reset-password
PASSWORD_RESET_EMAIL_SUBJECT=Atur ulang kata sandi Admin SMA
SMTP_ENABLED=true
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=REPLACE_IN_SECRET_STORE
SMTP_PASSWORD=REPLACE_IN_SECRET_STORE
SMTP_FROM=no-reply@example.com
SMTP_TLS_MODE=starttls
SMTP_TIMEOUT=10s
