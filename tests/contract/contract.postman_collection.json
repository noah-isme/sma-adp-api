  "event": [
    {
      "listen": "prerequest",
      "script": {
        "exec": [
          "const baseUrl = pm.variables.get('baseUrl') || pm.collectionVariables.get('baseUrl') || 'http://localhost:8080/api/v1';",
          "pm.collectionVariables.set('baseUrl', baseUrl.replace(/\\/$/, ''));",
          "if (!pm.collectionVariables.get('gatewayUrl')) {",
          "  pm.collectionVariables.set('gatewayUrl', baseUrl.replace(/\\/api\\/v1\\/?$/, '').replace(/\\/$/, ''));",
          "}",
          "const token = pm.variables.get('accessToken') || pm.collectionVariables.get('accessToken') || '';",
          "pm.collectionVariables.set('accessToken', token);"
        ],
        "type": "text/javascript"
      }
    },
    {
      "listen": "test",
      "script": {
        "exec": [
          "pm.test('status is successful', function () {",
          "  pm.expect(pm.response.code).to.be.within(200, 299);",
          "});",
          "pm.test('body is JSON when present', function () {",
          "  if (pm.response.text()) {",
          "    pm.expect(pm.response.headers.get('Content-Type') || '').to.include('application/json');",
          "  }",
          "});"
        ],
        "type": "text/javascript"
      }
    }
